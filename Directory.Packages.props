<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- DotCourier, consumed from nuget.org exactly as any application would -->
    <PackageVersion Include="DotCourier" Version="0.5.1" />
    <PackageVersion Include="DotCourier.AspNetCore" Version="0.5.1" />
    <PackageVersion Include="DotCourier.Caching" Version="0.5.1" />
    <PackageVersion Include="DotCourier.FluentValidation" Version="0.5.1" />
    <PackageVersion Include="DotCourier.Resilience" Version="0.5.1" />

    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.0" />
  </ItemGroup>
</Project>
